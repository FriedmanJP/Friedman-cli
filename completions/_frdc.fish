# Friedman-cli (frdc) fish completion (generated from APP)
function __frdc_path_is
  set -l tokens (commandline -opc)
  set -e tokens[1]
  set -l p
  set -l skip 0
  for t in $tokens
    if test $skip -eq 1
      set skip 0
      continue
    end
    switch $t
      case --seed --digits
        set skip 1
      case '-*'
        continue
      case ':*'
        break
      case '*'
        set -l pstr (string join ' ' -- $p)
        switch "$pstr|$t"
          case '|comp'
            set t 'completions'
          case '|d'
            set t 'data'
          case '|e'
            set t 'estimate'
          case '|est'
            set t 'estimate'
          case '|fc'
            set t 'forecast'
          case '|fcst'
            set t 'forecast'
          case '|flt'
            set t 'filter'
          case '|ha'
            set t 'hadsge'
          case '|m'
            set t 'model'
          case '|mod'
            set t 'model'
          case '|nc'
            set t 'nowcast'
          case '|pol'
            set t 'policy'
          case '|pr'
            set t 'predict'
          case '|pred'
            set t 'predict'
          case '|res'
            set t 'residuals'
          case '|resid'
            set t 'residuals'
          case '|sch'
            set t 'schema'
          case '|sh'
            set t 'show'
          case '|sp'
            set t 'spectral'
          case '|spec'
