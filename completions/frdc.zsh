  local -i i=2
  while (( i < CURRENT )); do
    w="${words[$i]}"
    if (( expect_val )); then
      expect_val=0; ((i++)); continue
    fi
    case "$w" in
      --seed|--digits) expect_val=1; ((i++)); continue ;;
      -*) ((i++)); continue ;;
    esac
    if (( ! is_leaf )); then
      akey="${path_str}|${w}"
      [[ -n "${_fn_aliases[$akey]-}" ]] && w="${_fn_aliases[$akey]}"
      cand=${path_str:+$path_str }$w
      if [[ -n "${_fn_leaves[$cand]-}" ]]; then
        path_str="$cand"; is_leaf=1
      elif [[ -n "${_fn_nodes[$cand]-}" ]]; then
        path_str="$cand"
      fi
    fi
    ((i++))
  done

  local -a cands
  if (( is_leaf )); then
    local ckey="${path_str}|${prev}"
    if [[ -n "${_fn_choices[$ckey]-}" ]]; then
      cands=(${=_fn_choices[$ckey]})
      _describe 'value' cands
    elif [[ "$cur" == -* ]]; then
      cands=(${=_fn_opts[$path_str]})
      _describe 'option' cands
    elif [[ "$cur" == :* ]]; then
      cands=(':ddcg' ':denmark' ':fred_md' ':fred_qd' ':gnp_hamilton' ':grunfeld' ':mp_shocks' ':mpdta' ':mroz' ':nile' ':pwt' ':stackloss')
      _describe 'dataset' cands
    else
      _files
    fi
  else
    if [[ "$prev" == "--digits" ]]; then
      cands=(0 1 2 3 4 6 full)
      _describe 'digits' cands
    elif [[ "$cur" == -* ]]; then
      if [[ -z "$path_str" ]]; then
        cands=(--help -h --version -V --warranty --conditions --quiet -q --no-color --json -J --compact --seed --digits)
      else
        cands=(--help -h)
      fi
      _describe 'option' cands
    elif [[ -z "$path_str" ]]; then
      cands=('completions' 'data' 'did' 'dsge' 'estimate' 'fevd' 'filter' 'forecast' 'hadsge' 'hd' 'io' 'irf' 'model' 'nowcast' 'policy' 'predict' 'repl' 'residuals' 'ri' 'schema' 'serve' 'show' 'spectral' 'test')
      _describe 'command' cands
    else
      cands=(${=_fn_nodes[$path_str]})
      _describe 'subcommand' cands
    fi
  fi
}
