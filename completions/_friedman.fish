# Friedman-cli fish completion (generated from APP)
function __friedman_path_is
  set -l tokens (commandline -opc)
  set -e tokens[1]
  set -l p
  set -l skip 0
  for t in $tokens
    if test $skip -eq 1
      set skip 0
      continue
    end
    switch $t
      case --seed
        set skip 1
      case '-*'
        continue
      case ':*'
        break
      case '*'
        set p $p $t
        test (count $p) -ge 3; and break
    end
  end
  test "$p" = "$argv[1]"
end

