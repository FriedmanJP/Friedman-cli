{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://friedmanjp.github.io/Friedman-cli/schema/envelope-v1.json",
  "title": "Friedman CLI result envelope v1 (draft until CLI v1.0)",
  "description": "Normative shape of stdout when --format=json. Kept in sync manually until docs generation (C028).",
  "type": "object",
  "required": ["schema_version", "command", "status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "command": { "type": "string" },
    "status": { "type": "string", "enum": ["ok", "error"] },
    "meta": {
      "type": "object",
      "additionalProperties": true
    },
    "data": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": ["columns", "rows"],
            "properties": {
              "columns": {
                "type": "array",
                "items": { "type": "string" }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": true
                }
              }
            }
          },
          { "type": ["number", "string", "boolean", "null", "array", "object"] }
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "properties": {
          "kind": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "hint": { "type": "string" }
          }
        }
      ]
    }
  }
}
